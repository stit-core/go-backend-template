{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "effortLevel": "max",
  "permissions": {
    "allow": [
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make fmt)",
      "Bash(make build*)",
      "Bash(make check)",
      "Bash(make gen)",
      "Bash(make gen-check)",
      "Bash(make migrate-up)",
      "Bash(make migrate-down)",
      "Bash(make e2e*)",
      "Bash(make new-domain*)",
      "Bash(make status*)",
      "Bash(make map*)",
      "Bash(make search*)",
      "Bash(make logs*)",
      "Bash(make doctor)",
      "Bash(make plan-check*)",
      "Bash(make setup)",
      "Bash(make tidy)",
      "Bash(make help)",
      "Bash(make release*)",
      "Bash(docker buildx*)",
      "Bash(bash scripts/release-preflight.sh*)",
      "Bash(scripts/release-preflight.sh*)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(go mod tidy)",
      "Bash(go list*)",
      "Bash(go doc*)",
      "Bash(gofumpt*)",
      "Bash(golangci-lint run*)",
      "Bash(sqlc*)",
      "Bash(mockery*)",
      "Bash(scripts/tools/*)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git tag -l*)",
      "Bash(git cat-file*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)"
    ],
    "deny": [
      "Bash(*--no-verify*)",
      "Bash(*--no-gpg-sign*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/infra/postgres/db/**)",
      "Edit(**/mocks/*.go)",
      "Edit(go.sum)",
      "Write(**/infra/postgres/db/**)",
      "Write(**/mocks/*.go)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-bash-no-verify.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-write-protect.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/pre-skill-domain-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/post-go-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/claude-hooks/stop-build-check.sh"
          }
        ]
      }
    ]
  }
}
