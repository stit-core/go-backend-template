# .env.local.example — шаблон dev-tooling кредов.
# Скопируй в .env.local (gitignored) и подставь реальные значения.
# .env.local НЕ коммитится (.gitignore).
#
# Это НЕ runtime-секреты приложения. Runtime app env — в .env для
# `go run ./cmd/api`, на VPS — Vault + vault-agent (см. infra-repo).
# Здесь — токены для dev-инструментов:
#   - e2e-стек:        test/stack/up.sh  (STIT_OBS_TOKEN + OTEL_TENANT)
#   - чтение прод-логов: scripts/agent-tools/logs.sh / скилл query-logs (STIT_OBS_TOKEN)
#
# Формат: KEY=value, по строке на секрет. Парсится grep'ом, не sourcing'ом —
# без многострочных значений и без $-подстановок. Значение токена в чат не
# вытаскивать — agent-tools читают файл сами и не эхо-ят секрет.

# Bearer для корп-observability (Loki/Tempo/OTLP edge). Tenant зашит в токене
# для logs.sh. Источник: корп-Vault kv/projects/<project>/<env>/otel —
# там же ротация.
STIT_OBS_TOKEN=replace-me

# Tenant для e2e otel-agent (test/stack/compose.yml). Совпадает с
# service_namespace (инвариант — stit-infra/infra ADR-0004 §2).
OTEL_TENANT=replace-me
