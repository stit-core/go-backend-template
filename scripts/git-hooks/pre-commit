#!/usr/bin/env bash
# pre-commit: быстрые проверки перед коммитом; полный гейт — pre-push (make check).
# Нет инструмента — коммит не проходит.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: make fmt-check"
make --no-print-directory fmt-check

echo "pre-commit: go vet ./..."
go vet ./...

echo "pre-commit: lint"
bash scripts/tools/lint.sh

CHANGED_STACK=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/stack/.*\.md$' || true)
if [ -n "$CHANGED_STACK" ]; then
    echo "pre-commit: validate-stack-doc (docs/stack/)"
    bash scripts/tools/validate-stack-doc.sh docs/stack
fi

CHANGED_PLANS=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^\.claude/plans/' || true)
if [ -n "$CHANGED_PLANS" ]; then
    echo "pre-commit: validate-plan (.claude/plans/)"
    bash scripts/tools/validate-plan.sh
fi

echo "pre-commit: all checks passed."
# Формат сообщения коммита (Conventional Commits) проверяет commit-msg hook.
