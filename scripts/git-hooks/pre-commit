#!/usr/bin/env bash
set -euo pipefail

echo "pre-commit: checking formatting with gofumpt..."
unformatted=$(gofumpt -l .)
if [ -n "$unformatted" ]; then
  echo "ERROR: the following files are not formatted with gofumpt:"
  echo "$unformatted"
  echo "Run: gofumpt -w ."
  exit 1
fi

echo "pre-commit: running go vet..."
go vet ./...

echo "pre-commit: running golangci-lint..."
if command -v golangci-lint &>/dev/null; then
  golangci-lint run ./...
else
  echo "golangci-lint not found, skipping (install from https://golangci-lint.run/usage/install/)"
fi

echo "pre-commit: validating stack artifacts in docs/stack/..."
CHANGED_STACK=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/stack/.*\.md$' || true)
if [ -n "$CHANGED_STACK" ]; then
    if [ -x scripts/tools/validate-stack-doc.sh ]; then
        scripts/tools/validate-stack-doc.sh docs/stack
    else
        echo "WARN: validate-stack-doc.sh not found or not executable, skipping"
    fi
fi

echo "pre-commit: validating plan roadmap (.claude/plans/roadmap.md)..."
CHANGED_ROADMAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.claude/plans/roadmap\.md$' || true)
if [ -n "$CHANGED_ROADMAP" ]; then
    if [ -x scripts/tools/validate-plan.sh ]; then
        scripts/tools/validate-plan.sh
    else
        echo "WARN: validate-plan.sh not found or not executable, skipping"
    fi
fi

echo "pre-commit: all checks passed."
# Напоминание: формат сообщения коммита (Conventional Commits) проверяется
# отдельным commit-msg hook (scripts/git-hooks/commit-msg). Установка — `make setup`.
