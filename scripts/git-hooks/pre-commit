#!/usr/bin/env bash
set -euo pipefail

# Ensure this script is executable
chmod +x "$0"

echo "pre-commit: checking formatting with gofumpt..."
unformatted=$(gofumpt -l .)
if [ -n "$unformatted" ]; then
  echo "ERROR: the following files are not formatted with gofumpt:"
  echo "$unformatted"
  echo "Run: gofumpt -w ."
  exit 1
fi

echo "pre-commit: running go vet..."
go vet ./...

echo "pre-commit: running golangci-lint..."
if command -v golangci-lint &>/dev/null; then
  golangci-lint run ./...
else
  echo "golangci-lint not found, skipping (install from https://golangci-lint.run/usage/install/)"
fi

echo "pre-commit: validating DDD artifacts in docs/domains/..."
CHANGED_DOCS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/domains/.*\.md$' || true)
if [ -n "$CHANGED_DOCS" ]; then
    if [ -x scripts/tools/validate-domain-doc.sh ]; then
        scripts/tools/validate-domain-doc.sh docs/domains
    else
        echo "WARN: validate-domain-doc.sh not found or not executable, skipping"
    fi
fi

echo "pre-commit: validating plans in .claude/plans/..."
CHANGED_PLANS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^\.claude/plans/.*\.md$' | grep -v '/roadmap\.md$' || true)
if [ -n "$CHANGED_PLANS" ]; then
    if [ -x scripts/tools/validate-plan.sh ]; then
        echo "$CHANGED_PLANS" | while IFS= read -r p; do
            [ -f "$p" ] && scripts/tools/validate-plan.sh "$p"
        done
    else
        echo "WARN: validate-plan.sh not found or not executable, skipping"
    fi
fi

echo "pre-commit: all checks passed."
# Напоминание: формат сообщения коммита (Conventional Commits) проверяется
# отдельным commit-msg hook (scripts/git-hooks/commit-msg). Установка — `make setup`.
