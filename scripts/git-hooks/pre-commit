#!/bin/bash -p
# pre-commit: быстрые проверки того, что уходит в коммит, — снимка индекса в своём worktree .cache/index-snapshot/wt:
# незакоммиченное и неотслеживаемое в дереве на вердикт не влияют. Полный гейт — pre-push (make check). Нет
# инструмента — коммит не проходит.
set -euo pipefail

# Переменные make вызывающего (MAKEFLAGS=i, MAKECMDGOALS, MAKEFILES) до make не доходят: каждая меняет шаги или
# выключает самозащиту гейта. Окружение оболочки (BASH_ENV, функции, SHELLOPTS) хук не читает (`bash -p`), а с
# рецептов его снимает Makefile — проверки идут через make.
for v in $(compgen -e); do
    if [[ $v =~ ^(MAKE.*|MFLAGS|GNUMAKEFLAGS)$ ]]; then unset "$v"; fi
done

root=$(git rev-parse --show-toplevel)
# Снимок — дерево индекса коммитом вне веток (недостижимый коммит git соберёт сам). Индекс — тот, что уходит в
# коммит: у git commit -a и git commit <пути> это временный индекс хука.
snapshot=$(GIT_AUTHOR_NAME=pre-commit GIT_AUTHOR_EMAIL=pre-commit@localhost GIT_COMMITTER_NAME=pre-commit \
    GIT_COMMITTER_EMAIL=pre-commit@localhost git commit-tree "$(git write-tree)" -m pre-commit </dev/null)
changed_stack=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^docs/stack/.*\.md$' || true)
changed_plans=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E '^\.claude/plans/' || true)
# Переменные git хука (GIT_INDEX_FILE временного индекса) увели бы команды в worktree снимка не туда.
# shellcheck disable=SC2046 # имена переменных — отдельными словами
unset $(git rev-parse --local-env-vars)

# Worktree снимка живёт между коммитами: кеш lint в нём тёплый. Каталог, который не worktree этого репо (репо
# перенесли или скопировали — снимок ведёт в прежний репо; первое создание оборвалось — каталог без .git), хук
# снимает и создаёт заново.
wt=$root/.cache/index-snapshot/wt
common=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
if [ "$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null)" = "$wt" ] &&
    [ "$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)" = "$common" ]; then
    git -C "$wt" checkout -q -f --detach "$snapshot"
    git -C "$wt" clean -q -fd
else
    rm -rf "$wt"
    mkdir -p "${wt%/*}"
    git -C "$root" worktree prune
    git -C "$root" worktree add -q --detach "$wt" "$snapshot"
fi
cd "$wt"

gate() { make -f Makefile --no-print-directory PKG= VERBOSE= FORMAT= A= "$@"; }

echo "pre-commit: make fmt-check"
gate fmt-check

echo "pre-commit: go vet -tags=integration ./..."
go vet -tags=integration ./...

echo "pre-commit: make lint"
gate lint

if [ -n "$changed_stack" ]; then
    echo "pre-commit: make validate-stack-docs (docs/stack/)"
    gate validate-stack-docs
fi

if [ -n "$changed_plans" ]; then
    echo "pre-commit: make plan-check (.claude/plans/)"
    gate plan-check
fi

echo "pre-commit: all checks passed."
# Формат сообщения коммита (Conventional Commits) проверяет commit-msg hook.
