#!/bin/bash -p
# Разрешённые типы описывает CLAUDE.md § Git workflow (их список сверяет с TYPES archtest TestCommitMsgHook),
# строку Review: — CLAUDE.md § Готово.
# Строка интерпретатора — `bash -p`: окружение оболочки коммитящего (BASH_ENV, функции, SHELLOPTS)
# хук не читает.
set -euo pipefail
# Под LC_ALL=C символ — байт: длину subject считаем без байтов-продолжений UTF-8, и предел в 72
# символа не зависит от локали того, кто коммитит.
export LC_ALL=C
COMMIT_MSG_FILE="$1"
TYPES='feat|fix|refactor|docs|test|chore|meta'
PATTERN="^($TYPES)(\\([a-z0-9_/-]+\\))?(!)?: (.+)\$"
# Сообщения, которые пишет сам git: git revert и git commit --fixup/--squash.
GIT_PATTERN='^((Revert|Reapply) ".+"|(fixup|squash|amend)! .+)$'
HEAD_LINE="$(head -n 1 "$COMMIT_MSG_FILE" | sed 's/[[:space:]]*$//')"
[[ "$HEAD_LINE" =~ $GIT_PATTERN ]] && exit 0
WHY="первая строка коммита должна быть Conventional Commit"
if [[ "$HEAD_LINE" =~ $PATTERN ]]; then
  TYPE=${BASH_REMATCH[1]}${BASH_REMATCH[2]}
  SUBJECT=${BASH_REMATCH[4]}
  CHARS=${SUBJECT//[$'\x80'-$'\xbf']/}
  # След ревью — строка тела: первая строка начинается с типа и строкой Review: не бывает. Его требуют feat, fix
  # и перенос обвязки chore(template): с ним в форк приходят гейт и код шаблона.
  if [ ${#CHARS} -gt 72 ]; then
    WHY="subject длиннее 72 символов (${#CHARS})"
  elif [[ $TYPE != feat* && $TYPE != fix* && $TYPE != "chore(template)" ]] || grep -qE '^Review: +[^[:space:]]' "$COMMIT_MSG_FILE"; then
    exit 0
  else
    WHY="у $TYPE в теле нет строки Review: — след ревью"
  fi
fi
echo "ERROR: $WHY"
echo "Формат: <type>(<scope>)?: <subject>  (≤72 символа; scope — строчные a-z, цифры, _, / и -)"
echo "Допустимые types: ${TYPES//|/, }"
echo "У feat, fix и chore(template) в теле — строка Review: <кто или чем> — <итог> (CLAUDE.md § Готово)"
echo "Сообщения самого git (Revert \"…\", fixup!/squash!/amend! …) тоже проходят"
echo "Пример: feat(user): add password reset"
echo
echo "        Review: /code-review — находок нет"
echo "Агент без собеседника: Review: принимает хаб (infra:<slug>) — дифф отдан, ревью не проводилось"
# cherry-pick после конфликта и git commit посреди rebase приносят сообщение чужого коммита — его дописывают, а не
# обходят (git rebase --continue хук не зовёт). Идущий rebase — каталог rebase-merge или rebase-apply: REBASE_HEAD
# git оставляет и после законченного.
for state in CHERRY_PICK_HEAD rebase-merge rebase-apply; do
  if [ -e "$(git rev-parse --git-path "$state" 2>/dev/null)" ]; then
    echo "Перенос коммита ($state): сообщение — его, допиши subject и строку Review: — ревью переноса"
    echo "  (Review: <кто или чем> — перенос <коммит>, <итог>) и закончи коммит: git commit -e (или -F <файл>);"
    if [ "$state" = CHERRY_PICK_HEAD ]; then
      echo "  если в цепочке есть ещё коммиты — git cherry-pick --continue"
    else
      echo "  затем всегда git rebase --continue — без него rebase не закончится"
    fi
    break
  fi
done
echo "Текущая первая строка: $HEAD_LINE"
exit 1
