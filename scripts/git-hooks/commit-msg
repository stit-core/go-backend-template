#!/bin/bash -p
# Разрешённые типы описывает CLAUDE.md § Git workflow.
# Строка интерпретатора — `bash -p`: окружение оболочки коммитящего (BASH_ENV, функции, SHELLOPTS)
# хук не читает.
# При смене списка править оба места одним коммитом.
set -euo pipefail
# Под LC_ALL=C символ — байт: длину subject считаем без байтов-продолжений UTF-8, и предел в 72
# символа не зависит от локали того, кто коммитит.
export LC_ALL=C
COMMIT_MSG_FILE="$1"
PATTERN='^(feat|fix|refactor|docs|test|chore|meta)(\([a-z0-9_/-]+\))?(!)?: (.+)$'
# Сообщения, которые пишет сам git: git revert и git commit --fixup/--squash.
GIT_PATTERN='^((Revert|Reapply) ".+"|(fixup|squash|amend)! .+)$'
HEAD_LINE="$(head -n 1 "$COMMIT_MSG_FILE" | sed 's/[[:space:]]*$//')"
[[ "$HEAD_LINE" =~ $GIT_PATTERN ]] && exit 0
WHY="первая строка коммита должна быть Conventional Commit"
if [[ "$HEAD_LINE" =~ $PATTERN ]]; then
  SUBJECT=${BASH_REMATCH[4]}
  CHARS=${SUBJECT//[$'\x80'-$'\xbf']/}
  [ ${#CHARS} -le 72 ] && exit 0
  WHY="subject длиннее 72 символов (${#CHARS})"
fi
echo "ERROR: $WHY"
echo "Формат: <type>(<scope>)?: <subject>  (≤72 символа)"
echo "Допустимые types: feat, fix, refactor, docs, test, chore, meta"
echo "Сообщения самого git (Revert \"…\", fixup!/squash!/amend! …) тоже проходят"
echo "Пример: feat(user): add password reset"
echo "       meta(rules): align commit-prefix SSOT"
echo "Текущая первая строка: $HEAD_LINE"
exit 1
