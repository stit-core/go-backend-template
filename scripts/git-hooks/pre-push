#!/bin/bash -p
# pre-push: канонический gate перед отправкой в remote — `make check` верхнего коммита каждого пушимого
# ref'а в свежем worktree (промежуточные коммиты push'а не гоняются). Вердикт — про то, что уходит в
# remote: незакоммиченные правки и игнорируемые файлы рабочего дерева на него не влияют. Кеш lint у
# свежего worktree холодный (lint.sh кладёт его в checkout). До гейта — сообщение каждого пушимого коммита
# (его нет ни в ветках remote'ов, ни под тегами шаблона template/* — эта история выпущена: клон форка без веток
# remote'а пушит её в пустой remote) хуком commit-msg из дерева его родителя: коммит cherry-pick, rebase
# (git rebase --continue хук не зовёт) или клона без хуков commit-msg не проходил, а правило — то, что
# действовало, когда коммит делали: старые коммиты правилом, которого тогда не было, не судятся.
#
# Строка интерпретатора — `bash -p`: файл автозапуска (BASH_ENV), экспортированные функции и SHELLOPTS
# из окружения пушащего хук не читает — иначе `exit 0` в них пропускал бы push без гейта.
#
# Обход — только руками человека: SKIP_PREPUSH=1 git push. Из сессии Claude его,
# --no-verify и core.hooksPath блокирует хук .claude/hooks/guard-bash.sh.
set -euo pipefail

# Переменные make пушащего (MAKEFLAGS=i, MAKECMDGOALS, MAKEFILES) до гейта не доходят: каждая меняет шаги или
# выключает его самозащиту. Окружение оболочки с рецептов гейта снимает Makefile.
for v in $(compgen -e); do
    if [[ $v =~ ^(MAKE.*|MFLAGS|GNUMAKEFLAGS)$ ]]; then unset "$v"; fi
done

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
    echo "pre-push: SKIP_PREPUSH=1 — пропускаю проверки"
    exit 0
fi

root=$(git rev-parse --show-toplevel)
# Хук git экспортирует GIT_DIR и соседей: в другом worktree они указали бы не туда.
# shellcheck disable=SC2046 # имена переменных — отдельными словами
unset $(git rev-parse --local-env-vars)

tmp="" msg=$(mktemp "${TMPDIR:-/tmp}/pre-push-msg.XXXXXX") rule=$(mktemp "${TMPDIR:-/tmp}/pre-push-hook.XXXXXX")
cleanup() {
    [ -z "$tmp" ] || git -C "$root" worktree remove --force "$tmp" 2>/dev/null || rmdir "$tmp" 2>/dev/null || true
    tmp=""
}
trap 'cleanup; rm -f "$msg" "$rule"' EXIT

# stdin: <local ref> <local sha> <remote ref> <remote sha> на каждый пушимый ref.
refs=$(cat)

# Корневой коммит и родитель без хука commit-msg не судятся: правила тогда не было.
while read -r _ local_sha _ remote_sha; do
    [[ -n $local_sha && ! $local_sha =~ ^0+$ ]] || continue
    known=(--remotes '--tags=template/*')
    if [[ ! $remote_sha =~ ^0+$ ]] && git -C "$root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        known+=("$remote_sha")
    fi
    for c in $(git -C "$root" rev-list --reverse "$local_sha" --not "${known[@]}"); do
        git -C "$root" show "$c^:scripts/git-hooks/commit-msg" >"$rule" 2>/dev/null || continue
        git -C "$root" log -1 --format=%B "$c" >"$msg"
        if ! out=$(bash -p "$rule" "$msg" 2>&1); then
            echo "pre-push: коммит $(git -C "$root" rev-parse --short "$c") — сообщение не по правилу commit-msg его родителя:"
            sed 's/^/  /' <<<"$out"
            echo "pre-push: допиши сообщение (git rebase -i, reword) и пушь снова; история шаблона известна по его тегам —"
            echo "  нет их: git fetch --no-tags <remote шаблона> 'refs/tags/template/*:refs/tags/template/*'"
            exit 1
        fi
    done
done <<<"$refs"

checked=" "
while read -r local_ref local_sha _ _; do
    [[ -n $local_sha && ! $local_sha =~ ^0+$ ]] || continue # удаление ref: проверять нечего
    commit=$(git -C "$root" rev-parse "$local_sha^{commit}")
    [[ $checked == *" $commit "* ]] && continue # ветка и тег на одном коммите — один прогон
    checked+="$commit "
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
    git -C "$root" worktree add --detach --quiet "$tmp" "$commit"
    echo "pre-push: $local_ref — make check в свежем worktree $(git -C "$root" rev-parse --short "$commit")"
    # stdin гейта — не список ref'ов; -f Makefile — GNUmakefile коммита make читал бы первым.
    make -C "$tmp" -f Makefile check </dev/null
    cleanup
done <<<"$refs"
