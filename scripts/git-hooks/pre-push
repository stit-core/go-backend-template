#!/usr/bin/env bash
# pre-push: канонический gate перед отправкой в remote — `make check` верхнего коммита каждого пушимого
# ref'а в свежем worktree (промежуточные коммиты push'а не гоняются). Вердикт — про то, что уходит в
# remote: незакоммиченные правки и игнорируемые файлы рабочего дерева на него не влияют. Кеш lint у
# свежего worktree холодный (lint.sh кладёт его в checkout).
#
# Обход — только руками человека: SKIP_PREPUSH=1 git push. Из сессии Claude его,
# --no-verify и core.hooksPath блокирует хук .claude/hooks/guard-bash.sh.
set -euo pipefail

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
    echo "pre-push: SKIP_PREPUSH=1 — пропускаю проверки"
    exit 0
fi

root=$(git rev-parse --show-toplevel)
# Хук git экспортирует GIT_DIR и соседей: в другом worktree они указали бы не туда.
# shellcheck disable=SC2046 # имена переменных — отдельными словами
unset $(git rev-parse --local-env-vars)

tmp=""
cleanup() {
    [ -z "$tmp" ] || git -C "$root" worktree remove --force "$tmp" 2>/dev/null || rmdir "$tmp" 2>/dev/null || true
    tmp=""
}
trap cleanup EXIT

# stdin: <local ref> <local sha> <remote ref> <remote sha> на каждый пушимый ref.
checked=" "
while read -r local_ref local_sha _ _; do
    [[ $local_sha =~ ^0+$ ]] && continue # удаление ref: проверять нечего
    commit=$(git -C "$root" rev-parse "$local_sha^{commit}")
    [[ $checked == *" $commit "* ]] && continue # ветка и тег на одном коммите — один прогон
    checked+="$commit "
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")
    git -C "$root" worktree add --detach --quiet "$tmp" "$commit"
    echo "pre-push: $local_ref — make check в свежем worktree $(git -C "$root" rev-parse --short "$commit")"
    # Переменные make из окружения пушащего (MAKEFLAGS=i, MAKEFILES, MAKECMDGOALS, MAKE…) до гейта не
    # доходят: каждая из них меняет шаги или выключает его самозащиту. stdin гейта — не список ref'ов,
    # его дочитывает цикл.
    drop=()
    while IFS= read -r -d '' entry; do
        if [[ ${entry%%=*} =~ ^(MAKE.*|MFLAGS|GNUMAKEFLAGS)$ ]]; then
            drop+=(-u "${entry%%=*}")
        fi
    done < <(env -0)
    env ${drop[@]+"${drop[@]}"} make -C "$tmp" check </dev/null
    cleanup
done
