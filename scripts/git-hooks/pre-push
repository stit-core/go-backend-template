#!/usr/bin/env bash
# pre-push: канонический локальный gate перед отправкой в remote.
# Без CI это последняя проверка — гонит весь pre-merge.
#
# Если хочешь skip ради скорости (например, push WIP-ветки) — push с
# --no-verify запрещён политикой проекта (pre-bash-no-verify hook у Claude
# тоже это блокирует). Если действительно нужно — пользователь руками
# выставляет SKIP_PREPUSH=1 git push.
set -e

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
    echo "pre-push: SKIP_PREPUSH=1 — пропускаю проверки"
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "pre-push: make pre-merge"
exec make pre-merge
