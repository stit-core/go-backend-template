      "UserUpdateOutputBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/UserUpdateOutputBody.json"
            ],
            "format": "uri",
