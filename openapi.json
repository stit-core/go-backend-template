      "APIError": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/APIError.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "code": {
            "description": "Stable machine-readable error code. Operation codes are listed in the response description; generic ones include VALIDATION_FAILED, BAD_REQUEST, UNAUTHORIZED, NOT_FOUND, METHOD_NOT_ALLOWED, BODY_TOO_LARGE, RATE_LIMITED, INTERNAL, UNAVAILABLE",
            "type": "string"
          },
          "detail": {
            "description": "Human-readable explanation of this occurrence; may be absent, and a 5xx never carries its internal cause",
            "type": "string"
          },
          "errors": {
            "description": "What is wrong in the request, field by field",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "request_id": {
            "description": "Request ID (X-Request-ID); the server logs carry the same ID",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "HTTP status text",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "type": "object"
      },
