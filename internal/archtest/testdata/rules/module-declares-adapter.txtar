# Конструктор адаптера в module.go: тип и конструктор адаптера — в adapters.go.
rule: TestModulesOnlyWire
base: canon
want: internal/domain/bill/module/module.go declares newShopAdapter, a constructor of an adapter
-- internal/domain/bill/module/module.go --
package module

import (
	"go.uber.org/fx"

	"{module}/internal/domain/bill"
	billnats "{module}/internal/domain/bill/delivery/nats"
	"{module}/internal/domain/shop"
)

var Module = fx.Module("{module}/internal/domain/bill/module",
	fx.Provide(
		newShopAdapter,
		func(a *shopAdapter) bill.Items { return a },
		bill.NewUsecase,
		func(uc *bill.Usecase) billnats.Usecase { return uc },
		billnats.NewHandler,
	),
	fx.Invoke(billnats.Register),
)

func newShopAdapter(items *shop.Trusted) *shopAdapter { return &shopAdapter{items: items} }
-- internal/domain/bill/module/adapters.go --
package module

import (
	"context"
	"errors"

	"{module}/internal/domain/bill"
	"{module}/internal/domain/shop"
)

type shopAdapter struct {
	items *shop.Trusted
}

func (a *shopAdapter) Lookup(ctx context.Context, id string) (*bill.Item, error) {
	it, err := a.items.Lookup(ctx, id)
	if errors.Is(err, shop.ErrNotFound) {
		return nil, bill.ErrItemNotFound
	}
	if err != nil {
		return nil, err
	}
	return &bill.Item{ID: it.ID, Name: it.Name}, nil
}
