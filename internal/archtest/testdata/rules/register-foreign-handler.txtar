# Хендлер не из пакета входа: правила таблиц ошибок и policy читают только его функции.
rule: TestInputsRegisterInDelivery
base: canon
want: registers handler shoppg.Count, which is not a method, function or literal of delivery/http
-- internal/domain/shop/delivery/http/count.go --
package http

import (
	"net/http"

	"github.com/danielgtaylor/huma/v2"

	shoppg "{module}/internal/domain/shop/infra/postgres"
	"{module}/internal/platform/authgate"
)

func RegisterCount(api huma.API) {
	huma.Register(api, getErrors.Declare(authgate.Secured(huma.Operation{
		OperationID: "countItems",
		Method:      http.MethodGet,
		Path:        "/api/items/count",
	})), shoppg.Count)
}
