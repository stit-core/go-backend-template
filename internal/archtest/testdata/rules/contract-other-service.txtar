# Законно: событие другого сервиса — payload из его контракта: настоящего usecase поставщика в репо нет.
rule: TestSubscriptionsHaveContractTest
base: canon
-- internal/domain/bill/delivery/nats/billing.go --
package nats

// SubjectInvoicePaid — событие сервиса billing (контракт — его артефакт strategy).
const SubjectInvoicePaid = "billing.events.invoice_paid"
-- internal/domain/bill/delivery/nats/contract_test.go --
package nats_test

import (
	"context"
	"testing"

	"github.com/stretchr/testify/require"
	"go.uber.org/fx/fxtest"

	billnats "{module}/internal/domain/bill/delivery/nats"
	"git.stit.tech/stit-core/golibinfra/testkit/natstest"
	"git.stit.tech/stit-core/golibinfra/testkit/outboxtest"
)

func TestContracts(t *testing.T) {
	bus := natstest.New(natstest.WithStream("shop"), natstest.WithStream("billing"))
	lc := fxtest.NewLifecycle(t)
	billnats.Register(lc, bus, billnats.NewHandler(nil))
	lc.RequireStart()
	events := invoicePaid()
	for _, e := range events {
		require.NoError(t, bus.Deliver(context.Background(), e.Subject, e.Payload))
	}
	for _, filter := range bus.Subscriptions() {
		require.NotEmpty(t, filter)
	}
}

// invoicePaid — payload из контракта billing.
func invoicePaid() []outboxtest.Event {
	return []outboxtest.Event{{Subject: billnats.SubjectInvoicePaid, Payload: []byte(`{"InvoiceID":"b1"}`)}}
}
