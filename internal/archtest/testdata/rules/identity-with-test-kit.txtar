# Законно: тестовый кит кладёт личность в ctx тестов.
rule: TestIdentityWithOnlyInAuthgate
base: canon
-- internal/testkit/identitytest/identitytest.go --
package identitytest

import (
	"context"

	"{module}/internal/platform/identity"
)

func Client(id string) context.Context {
	return identity.With(context.Background(), identity.Identity{UserID: id, Role: identity.RoleClient})
}
