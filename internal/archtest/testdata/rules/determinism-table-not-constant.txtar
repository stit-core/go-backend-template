# Не таблица-литерал: экспортируемая (её пишет любой пакет), со значением из вызова и с адресом — разделяемым значением.
rule: TestDomainDeterminism
base: canon
want: internal/domain/shop/tables.go declares package var Services: state between requests lives in the database or a kit
want: internal/domain/shop/tables.go declares package var upper: state between requests lives in the database or a kit
want: internal/domain/shop/tables.go declares package var items: state between requests lives in the database or a kit
