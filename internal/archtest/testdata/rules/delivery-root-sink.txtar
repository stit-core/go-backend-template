# Законно: приёмник выгрузки — интерфейс корня, который вход реализует и отдаёт методу usecase с policy.
rule: TestDeliveryReachesUsecaseOnly
base: canon
-- internal/domain/shop/export.go --
package shop

import "context"

// ExportSink — приёмник выгрузки: строки товаров по одной.
type ExportSink interface {
	Write(ctx context.Context, it *Item) error
}
-- internal/domain/shop/delivery/http/export.go --
package http

import (
	"context"

	"{module}/internal/domain/shop"
