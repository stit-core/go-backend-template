# Local-dev .env для `go run ./cmd/api`. Минимум чтобы binary поднялся.
#
# Production env живёт в <project>/infra (см. stit-core/project-infra-template-compose):
#   - Секреты (PG_DSN c реальным паролем, OIDC, JWT) и не-секретный tuning
#     (HTTP_RATE_LIMIT_RPS, PG_MAX_CONNS и т.п.) задаёт проектная инфра —
#     inline в compose/backend.yml `environment:` блоке (видно в репо,
#     ревьюится на PR'ах). У всех ENV из golibinfra/{httpkit,pgkit} есть
#     code-defaults; переопределяй только когда дефолт не подходит.
#
# Здесь — то, что binary требует обязательно, пара local-dev удобств и закомментированные
# настройки деплоя, которые проектная инфра задаёт сама. Остальное берётся из дефолтов
# golibinfra; смотри envconfig-тэги в полях Config-структур этих пакетов.

# ─── Required (без них сервис не стартует) ────────────────────────────
PG_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
# Ключ подписи сессий (HS256, от 32 байт). Значение — только для локальной разработки: в проде
# секрет задаёт <project>/infra.
JWT_SECRET=local-dev-only-jwt-secret-at-least-32-bytes
# Окружение. Только dev пускает небезопасное: cookie без Secure, лог-mailer (письма не уходят),
# логи без маскирования и docs; вне dev с любым из них старт падает.
APP_ENV=dev
# Стрим на домен-публикатор: natskit создаёт `<имя>` с subject'ами `<имя>.>`. Без JetStream или
# стрима `user` (его читает подписчик verification) старт падает; без стрима `verification` сервис
# стартует, но события verification не публикуются — строки копятся в её outbox.
# Локально — `make local-deps-up` (NATS с `-js`).
NATS_JETSTREAM_ENABLED=true
NATS_JS_STREAM_NAMES=user,verification
# NATS_URL=nats://localhost:4222     # дефолт кита
# Телеметрия (OTLP): без коллектора — выключена. С коллектором — OTEL_SDK_DISABLED=false,
# OTEL_SERVICE_NAME и OTEL_EXPORTER_OTLP_ENDPOINT; включённая без OTEL_SERVICE_NAME — старт падает.
OTEL_SDK_DISABLED=true

# ─── Local-dev удобства ───────────────────────────────────────────────
# Cookie сессии без Secure — для клиентов, которые не шлют Secure-cookie по http (curl, Safari).
COOKIE_SECURE=false
# HTTP_DOCS_ENABLED=true             # /docs, /openapi.*, /schemas; по умолчанию false, true — только в dev
# Логи — JSON в stdout (docker/kubectl logs); LOG_SILENT=true глушит локальный sink.
# LOG_FORMAT=text                    # human-readable для локальной разработки (json — прод)
# LOG_SILENT=false                   # true — записи в stdout не пишутся
# LOG_LEVEL=info                     # debug|info|warn|error
# Секреты в логах маскируются всегда (ключи token/password/secret/cookie…, hex от 32 символов).
# LOG_REDACT_DISABLED=false          # true — выключить маскирование (только в dev)

# ─── Деплой: дефолты китов, значения задаёт <project>/infra ────────────
# aud access-токенов — имя сервиса (через запятую — несколько); вне dev обязателен: без него сервисы на
# общем JWT_SECRET принимают токены друг друга. JWT_ISSUER — iss; JWT_PREVIOUS_SECRET — прежний ключ на
# время ротации JWT_SECRET.
# JWT_AUDIENCE=backend
# JWT_ISSUER=
# JWT_PREVIOUS_SECRET=
# За reverse-proxy (Traefik) — 1: IP клиента — запись X-Forwarded-For, которую дописал прокси. С 0 (дефолт)
# IP клиента — адрес прокси: все клиенты делят один bucket лимитера и антибрутфорса.
# HTTP_TRUST_PROXY_HOPS=1
# Остановка: /ready отвечает 503 паузу HTTP_SHUTDOWN_DRAIN_DELAY (за балансировщиком 5s — он успевает
# вывести инстанс; дефолт 0s), затем запросы в полёте дорабатывают HTTP_SHUTDOWN_TIMEOUT. Сумма — не
# больше 20s, NATS_DRAIN_TIMEOUT — не больше 10s, иначе старт падает: бюджет остановки 30s.
# HTTP_SHUTDOWN_DRAIN_DELAY=5s
# HTTP_SHUTDOWN_TIMEOUT=10s
# Сессия refresh: токен живёт SESSION_IDLE_TTL от выдачи, сессия — SESSION_ABSOLUTE_TTL от входа (ротация её
# не продлевает); истёкшие сессии чистит job раз в SESSION_CLEANUP_INTERVAL.
# SESSION_IDLE_TTL=168h
# SESSION_ABSOLUTE_TTL=720h
# SESSION_CLEANUP_INTERVAL=1h
# Событие outbox после стольких неудачных публикаций — dead (ERROR outboxkit: event dead): отказ, который
# повтор не исправит, не крутится вечно; -1 — без предела, 0 — ошибка старта.
# OUTBOX_MAX_ATTEMPTS=25

# ─── Registry образов (release-time, не env приложения) ───────────────
# `make release` пушит образы в registry git-хоста из `git remote get-url origin`
# (scripts/release.sh). <project>/infra тянет их из registry REGISTRY_HOST
# (дефолт git.stit.tech) — это тот же хост.
