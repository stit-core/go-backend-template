# Backend service env. Copy to .env and fill in. See AGENTS.md for stack
# overview; see stit/infra/docs/onboarding.md for how OTEL_TENANT/OTEL_TOKEN
# are provisioned by the corp infra side (scripts/onboard-project.sh).

# ─── Application ──────────────────────────────────────────────────────
APP_ENV=dev                          # dev | staging | prod

# ─── HTTP server (httpkit) ────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_API_TITLE=API
HTTP_API_VERSION=0.1.0
HTTP_MAX_BODY_BYTES=1048576
HTTP_RATE_LIMIT_RPS=100
HTTP_RATE_LIMIT_BURST=200
HTTP_CORS_ORIGINS=
HTTP_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
HTTP_CORS_HEADERS=Authorization,Content-Type,X-Request-ID
HTTP_CORS_MAX_AGE=600
HTTP_HSTS=max-age=31536000; includeSubDomains
HTTP_CSP=

# ─── Postgres (pgkit) ─────────────────────────────────────────────────
PG_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_MIGRATIONS_PATH=./migrations

# ─── Telemetry (golibinfra/telemetry) ─────────────────────────────────
# Local dev: stdout-only or shipping to a local collector.
OTEL_SERVICE_NAME=backend            # required
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true     # set false when shipping to corp
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORT_TIMEOUT=10s
OTEL_STDOUT_ONLY=false

# Corp shared observability (otel.stit.tech). Provisioned per-project by
# the infra-side onboard-project.sh; the operator hands you these values.
# When OTEL_TENANT is set, telemetry/Init adds it as service.namespace
# and as a free-form `tenant` resource attribute that the corp otel-
# collector uses to route signals into per-tenant Loki/Tempo/VM streams.
# OTEL_TOKEN is sent as Authorization: Bearer on every OTLP exporter
# request; tenant-auth in front of the collector validates it. Leave
# empty for local dev.
OTEL_TENANT=
OTEL_TOKEN=

# When shipping to corp:
#   OTEL_EXPORTER_OTLP_ENDPOINT=otel.stit.tech:443
#   OTEL_EXPORTER_OTLP_INSECURE=false
#   OTEL_TENANT=<project-name>
#   OTEL_TOKEN=<provisioned token>
