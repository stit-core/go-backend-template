# Local-dev defaults for `go run ./cmd/api`. Copy to .env and adjust.
#
# Production env (corp-shared OTel + Vault + per-project secrets) lives
# in <project>/infra — see stit/project-infra-template-compose. This
# file documents only what the binary itself reads at runtime.

# ─── Application ──────────────────────────────────────────────────────
APP_ENV=dev                          # dev | staging | prod

# ─── HTTP server (httpkit) ────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_API_TITLE=API
HTTP_API_VERSION=0.1.0
HTTP_MAX_BODY_BYTES=1048576
HTTP_RATE_LIMIT_RPS=100
HTTP_RATE_LIMIT_BURST=200
HTTP_CORS_ORIGINS=
HTTP_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
HTTP_CORS_HEADERS=Authorization,Content-Type,X-Request-ID
HTTP_CORS_MAX_AGE=600
HTTP_HSTS=max-age=31536000; includeSubDomains
HTTP_CSP=

# ─── Postgres (pgkit) ─────────────────────────────────────────────────
PG_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_MIGRATIONS_PATH=./migrations

# ─── Telemetry (golibinfra/telemetry) ─────────────────────────────────
# Local dev: stdout-only by default; flip OTEL_STDOUT_ONLY=false to ship
# to a local collector at OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_SERVICE_NAME=backend            # required
OTEL_SERVICE_VERSION=dev
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORT_TIMEOUT=10s
OTEL_STDOUT_ONLY=true

# OTEL_TENANT / OTEL_TOKEN are populated only in production by the
# infra-side vault-agent (rendered into env_file at deploy time).
# Leave empty for local dev.
OTEL_TENANT=
OTEL_TOKEN=
