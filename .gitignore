# Окружение и ключи — имена перечня секретов pre-push, без учёта регистра (сверяет TestNoSecretFiles).
.[eE][nN][vV]
.[eE][nN][vV].*
!*.[eE][xX][aA][mM][pP][lL][eE]
bin/
/.cache/
*.test
*.out
coverage.*

# Секреты / TLS-артефакты — в репо не хранятся
*.[pP][eE][mM]
*.[kK][eE][yY]
credentials.md

# Python e2e-харнес (test/)
test/stack/.e2e-endpoints.env
test/.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

